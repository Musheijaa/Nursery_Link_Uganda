{
  "name": "nursery-link-uganda",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nurserylink/api --filter @nurserylink/web --filter @nurserylink/admin dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter @nurserylink/api db:migrate",
    "db:seed": "pnpm --filter @nurserylink/api db:seed",
    "db:reset": "pnpm --filter @nurserylink/api db:reset",
    "api:generate": "pnpm --filter @nurserylink/api-client generate"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "lighthouse": "^13.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
