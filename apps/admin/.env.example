# Where the API lives. Empty = same origin (the dev and preview servers proxy /api to API_PROXY_TARGET).
VITE_API_URL=
# Map tiles (nursery location picker, Nursery Shadow map)
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
API_PROXY_TARGET=http://localhost:4000
# Where the public site lives, for photos it serves (/images/...). Empty = same origin
# (the dev and preview servers proxy /images to WEB_PROXY_TARGET, default the web dev/preview port).
VITE_PUBLIC_WEB_URL=
WEB_PROXY_TARGET=
