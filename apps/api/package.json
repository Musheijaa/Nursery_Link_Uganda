{
  "name": "@nurserylink/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file=../../.env src/server.ts",
    "serve:source": "tsx --conditions=source --env-file=../../.env src/server.ts",
    "build": "pnpm --filter @nurserylink/shared build && tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/ && mkdir -p dist/db/seed && cp -r src/db/seed/data dist/db/seed/",
    "start": "node --env-file=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "pnpm --filter @nurserylink/shared build && drizzle-kit generate",
    "db:migrate": "tsx --conditions=source --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --conditions=source --env-file=../../.env src/db/seed/index.ts",
    "db:reset": "tsx --conditions=source --env-file=../../.env src/db/reset.ts",
    "db:demo-activity": "tsx --conditions=source --env-file=../../.env src/db/demoActivity.ts",
    "db:demo-nurseries": "tsx --conditions=source --env-file=../../.env src/db/demoNurseries.ts",
    "db:forest-sample": "tsx --conditions=source --env-file=../../.env src/db/forestLossSample.ts",
    "openapi:export": "tsx --conditions=source src/openapi/export.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@nurserylink/shared": "workspace:*",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "pg-boss": "^10.4.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
