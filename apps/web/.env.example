# Where the API lives. Empty = same origin (the dev and preview servers proxy /api to API_PROXY_TARGET).
VITE_API_URL=
# Google Maps JavaScript API (Google Cloud project with billing; restrict the key to this site's domains).
# Without a key the maps are replaced by the nursery list and a "map unavailable" note. Never commit a key.
VITE_GOOGLE_MAPS_API_KEY=
# A Map ID (Google Cloud console, Map Management, type JavaScript, vector), needed for the custom pins.
# Empty uses Google's DEMO_MAP_ID, which is only for development.
VITE_GOOGLE_MAPS_MAP_ID=
# Dev/preview only: where to proxy /api
API_PROXY_TARGET=http://localhost:4000
