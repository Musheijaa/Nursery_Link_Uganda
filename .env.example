# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://nurserylink:nurserylink_dev@127.0.0.1:5433/nurserylink
TEST_DATABASE_URL=postgres://nurserylink:nurserylink_dev@127.0.0.1:5433/nurserylink_test

# ── API server ──────────────────────────────────────────────
PORT=4000
# Public URL of the site, used for CORS and provider callback URLs
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
# Long random string used to sign cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# ── Payments ────────────────────────────────────────────────
# simulated | live
# "simulated" approves payments from the site (development only).
# "live" uses the MTN and Airtel credentials below.
PAYMENT_MODE=simulated

# MTN MoMo Open API (https://momodeveloper.mtn.com)
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CURRENCY=EUR
MTN_COLLECTION_SUBSCRIPTION_KEY=
MTN_COLLECTION_API_USER=
MTN_COLLECTION_API_KEY=
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_DISBURSEMENT_API_USER=
MTN_DISBURSEMENT_API_KEY=

# Airtel Money Open API (https://developers.airtel.africa)
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
# PIN for disbursements, encrypted with Airtel's public key as their docs describe
AIRTEL_DISBURSEMENT_PIN_ENCRYPTED=

# ── SMS ─────────────────────────────────────────────────────
# console | africastalking
SMS_MODE=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ── Admin account created by `npm run db:seed` ──────────────
ADMIN_PHONE=0700000001
ADMIN_PASSWORD=change-me-admin
